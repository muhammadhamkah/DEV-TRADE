# Copy to .env. The agent's only credential. Set a hard spend limit on this key in the console.
ANTHROPIC_API_KEY=sk-ant-...

STARTING_BALANCE=50
DAILY_RENT=0.50
TICK_SECONDS=3600
SURVIVAL_MODEL=claude-opus-5
DEFAULT_EFFORT=medium
MAX_TOOL_CALLS_PER_TICK=12

# Guardrails enforced by the harness
MAX_POSITION_FRAC=0.25
MAX_OPEN_POSITIONS=6
SLIPPAGE_BPS=50
FEE_BPS=0

# Paper only. LIVE_TRADING=1 currently refuses to start.
LIVE_TRADING=0
