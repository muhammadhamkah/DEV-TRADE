# Copy to .env. Pick ONE backend section and fill it in.

# --- Backend: ollama (free, local) --------------------------------------------
BACKEND=ollama
SURVIVAL_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=1

# --- Backend: openai (any OpenAI-compatible endpoint; Groq and Gemini have free tiers)
# Groq free tier: get a key at console.groq.com. openai/gpt-oss-120b supports low/medium/high effort;
# llama-3.3-70b-versatile is the alternative. Free tiers cap requests per day; with continuous
# wake-ups you may hit the cap and the agent will stall until it resets. TICK_SECONDS=1800 stays under it.
#BACKEND=openai
#SURVIVAL_MODEL=openai/gpt-oss-120b
#OPENAI_BASE_URL=https://api.groq.com/openai/v1
#OPENAI_API_KEY=gsk_...

# --- Backend: anthropic (paid; real inference cost is what the agent pays) -----
#BACKEND=anthropic
#SURVIVAL_MODEL=claude-opus-5
#ANTHROPIC_API_KEY=sk-ant-...     # set a hard spend limit on this key in the console

# What a token costs the agent on paper when the backend is free (USD per million).
# Defaults match Claude Opus 5 so survival pressure is the same either way.
SYNTHETIC_PRICE_INPUT=5
SYNTHETIC_PRICE_OUTPUT=25

# --- Economy --------------------------------------------------------------------
STARTING_BALANCE=500
MEAL_PRICE=0.50        # one meal
MEAL_RESTORES=50       # hunger points a meal removes, on a 0..100 scale
STARVE_DAYS=2          # days from just-fed to dead with no food (so staying fed costs ~$0.50/day)
TICK_SECONDS=1800      # scheduled wake-up interval; 0 = wake again the moment the last wake-up ends
WATCH_SECONDS=60       # how often the harness checks prices and hunger for free
WAKE_ON_MOVE=0.05      # wake early if a held outcome's bid moves this much
SCAN_SECONDS=300       # free opportunity scanner: sweep the busiest 100 markets this often
SCAN_MOVE=0.08         # price jump between sweeps that wakes the agent with a lead
SCAN_ARB=0.03          # Yes+No below 0.97 wakes the agent with a lead
SLEEP_ENABLED=0        # 1 lets it skip wake-ups to save inference; 0 means it must earn its food every hour
DEFAULT_EFFORT=medium
MAX_TOOL_CALLS_PER_TICK=20

# --- Guardrails enforced by the harness -----------------------------------------
MAX_POSITION_FRAC=0.25
MAX_OPEN_POSITIONS=6
SLIPPAGE_BPS=50
FEE_BPS=0

# Paper only. LIVE_TRADING=1 currently refuses to start.
LIVE_TRADING=0
